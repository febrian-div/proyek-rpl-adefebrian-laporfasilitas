<?php
use App\Middleware\AuthMiddleware;
use App\Helpers\Response;
use App\Models\Notification;

$currentUser = AuthMiddleware::user();
$flash = Response::getFlash();

$unreadNotifications = [];
if ($currentUser) {
    // Supress error if table doesn't exist yet
    try {
        $unreadNotifications = Notification::getUnreadByUser((int)$currentUser['id']);
    } catch (\Throwable $e) {}
}
?>
