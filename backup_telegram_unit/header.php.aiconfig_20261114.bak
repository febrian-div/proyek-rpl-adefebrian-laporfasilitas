                        <li class="nav-item"><a href="<?= base_url('/petugas') ?>"><i class="fa-solid fa-screwdriver-wrench"></i> Tugas Perbaikan</a></li>
                    <?php endif; ?>

                    <!-- Notification Dropdown -->
                    <li class="nav-item notification-dropdown">
                        <a href="javascript:void(0)" class="notification-toggle" onclick="toggleNotifications()">
                            <i class="fa-solid fa-bell"></i>
                            <?php if (count($unreadNotifications) > 0): ?>
                                <span class="notification-badge"><?= count($unreadNotifications) ?></span>
                            <?php endif; ?>
                        </a>
                        <div class="notification-menu" id="notificationMenu" style="display: none;">
                            <div class="notification-header flex justify-between items-center pb-2 mb-2 border-b">
                                <h4 class="font-bold m-0 text-sm">Notifikasi</h4>
                                <?php if (count($unreadNotifications) > 0): ?>
                                    <button class="text-primary text-xs font-semibold cursor-pointer border-none bg-transparent" onclick="markAllNotificationsRead()">Tandai Semua Dibaca</button>
                                <?php endif; ?>
                            </div>
                            <div class="notification-list" style="max-height: 300px; overflow-y: auto;">
                                <?php if (empty($unreadNotifications)): ?>
                                    <div class="text-center py-3 text-muted text-xs">
                                        Tidak ada notifikasi baru.
                                    </div>
                                <?php else: ?>
                                    <?php foreach ($unreadNotifications as $notif): ?>
                                        <div class="notification-item p-2 mb-2 rounded" id="notif-<?= $notif['id'] ?>" style="background: var(--bg-secondary); border-left: 3px solid var(--primary-color);">
                                            <div class="flex justify-between items-start mb-1">
                                                <h5 class="font-bold text-xs m-0"><?= htmlspecialchars($notif['title']) ?></h5>
                                                <button class="text-muted text-xs border-none bg-transparent cursor-pointer" onclick="markNotificationRead(<?= $notif['id'] ?>)" title="Tandai dibaca"><i class="fa-solid fa-xmark"></i></button>
                                            </div>
                                            <p class="text-xs text-muted m-0 mb-1"><?= htmlspecialchars($notif['message']) ?></p>
                                            <small class="text-xs text-muted" style="font-size: 0.65rem;"><?= date('d M H:i', strtotime($notif['created_at'])) ?></small>
