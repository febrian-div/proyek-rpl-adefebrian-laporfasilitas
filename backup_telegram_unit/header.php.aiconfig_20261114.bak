                    <li class="nav-item"><a href="<?= base_url('/login') ?>" class="btn btn-secondary btn-sm"><i class="fa-solid fa-arrow-right-to-bracket"></i> Masuk</a></li>
                    <li class="nav-item"><a href="<?= base_url('/register') ?>" class="btn btn-primary btn-sm"><i class="fa-solid fa-user-plus"></i> Daftar</a></li>
