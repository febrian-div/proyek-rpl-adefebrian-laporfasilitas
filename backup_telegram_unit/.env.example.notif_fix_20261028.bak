# Konfigurasi Aplikasi LaporFasilitas
APP_NAME=LaporFasilitas
APP_ENV=development
APP_URL=http://localhost/projekfasilitas/public
APP_TIMEZONE=Asia/Jakarta

# Konfigurasi Database (Default XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_laporfasilitas
DB_USERNAME=root
DB_PASSWORD=

# Konfigurasi Integrasi AI (Opsional jika menggunakan Gemini / OpenAI / NVIDIA NIM)
# Salin file ini menjadi .env lalu isi API key di .env (jangan commit .env).
AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Model chat (opsional; default gemini-1.5-flash / gpt-4o-mini)
AI_MODEL=gemini-1.5-flash

# Konfigurasi Integrasi Telegram (Opsional untuk notifikasi)
# Salin file ini menjadi .env lalu isi nilai di .env (jangan commit .env).
# Jika tidak diisi atau dinonaktifkan, notifikasi website tetap berfungsi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_WEBHOOK_SECRET=
